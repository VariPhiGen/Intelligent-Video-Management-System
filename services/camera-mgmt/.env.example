# ─────────────────────────────────────────────────────────────────────────────
# camera-mgmt — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────

# Static IP (or hostname) of THIS server, used to construct local RTSP URLs
# that are returned to API clients (e.g. rtsp://<SERVER_IP>:8654/<slug>)
SERVER_IP=192.168.1.100

# Port on which MediaMTX listens for RTSP connections. 8654, not the RTSP
# default 8554, so this relay can coexist with another MediaMTX on the same
# host — deploy/mediamtx.yml binds it and the root .env.example agrees.
RTSP_PORT=8654

# Port on which FastAPI listens. It also serves the management UI (SPA) and API
# docs on this same port — browse to http://<server-ip>:8091/ . There is no
# separate nginx/frontend container. This is the single knob for the app port;
# nothing else hardcodes it (compose, healthcheck, Caddy and the dev proxy all
# read API_PORT).
API_PORT=8091

# ── Identity / OIDC (Keycloak) — guards the management UI + /api ───────────────
# All user auth is OIDC. Keycloak (self-hosted, air-gap capable) is the issuer;
# the API validates Bearer JWTs against its JWKS and enforces RBAC roles
# (admin / operator / dpo). Realm is imported from keycloak/realm-vms.json.
#
# DEV_AUTH=true bypasses OIDC (every request = full admin) so the stack boots
# without Keycloak. MUST be false in production.
DEV_AUTH=false

# Default: plain HTTP on a trusted single box — app at http://localhost:8091 ,
# Keycloak at http://localhost:8085 . The OIDC issuer must match the host the
# BROWSER uses to reach Keycloak (use the server IP instead of localhost if you
# access the UI from other machines).
KEYCLOAK_PORT=8085
OIDC_ISSUER=http://localhost:8085/realms/vms
OIDC_PUBLIC_URL=http://localhost:8085
# The API fetches JWKS locally over plain HTTP. Keep in sync with KEYCLOAK_PORT.
OIDC_JWKS_URL=http://127.0.0.1:8085/realms/vms/protocol/openid-connect/certs
OIDC_CLIENT_ID=vms-web
OIDC_AUDIENCE=
#
# OPTIONAL TLS (for hardened/production deployments — see HARDENING.md):
# run ./scripts/gen-certs.sh, start Caddy with `docker compose --profile tls up
# -d caddy`, and switch the two URLs above to:
#   OIDC_ISSUER=https://<SERVER_IP>:8444/realms/vms
#   OIDC_PUBLIC_URL=https://<SERVER_IP>:8444

# Explicit cross-origin API callers (comma-separated). Empty = same-origin only,
# which is the norm since the SPA is served behind the same TLS front door.
CORS_ORIGINS=

# Keycloak master-realm admin (console at https://<SERVER_IP>:8443/).
# Generate the password with scripts/gen-secrets.sh — do NOT hand-set a weak one.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_RUN_gen-secrets.sh

# Shared key for trusted machine-to-machine callers of the API (accepted via
# the X-Internal-Key header in place of a user token). Generate with
# scripts/gen-secrets.sh — never commit a real value.
INTERNAL_API_KEY=CHANGE_ME_RUN_gen-secrets.sh

# ── Database ─────────────────────────────────────────────────────────────────

POSTGRES_USER=rtsp
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rtsp_relay

# Full async connection string (must use asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rtsp:change_me_in_production@127.0.0.1:5432/rtsp_relay

# ── Redis ────────────────────────────────────────────────────────────────────

# Host port is 6380 (not the default 6379) to avoid colliding with another redis
# already on the box. Must match the REDIS_HOST_PORT mapping in docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6380/0

# ── MediaMTX ─────────────────────────────────────────────────────────────────

# REST API base URL for the running MediaMTX instance
# When using host networking (docker-compose default), this is localhost
# When using bridge networking, use the container name: http://mediamtx:9997
MEDIAMTX_API_URL=http://127.0.0.1:9997

# ── Workers & Performance ─────────────────────────────────────────────────────

# Maximum number of concurrent FFmpeg transcoding sidecar processes.
# Each transcoding process uses ~80-200 MB RAM and 0.5-2 CPU cores.
# Pass-through streams (H.264/H.265 stream copy) do NOT consume a worker slot.
MAX_TRANSCODE_WORKERS=8

# ── Health Monitor ────────────────────────────────────────────────────────────

# Interval (seconds) between health checks for each active stream
HEALTH_POLL_INTERVAL=30

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: debug | info | warning | error | critical
LOG_LEVEL=info

# ── Camera discovery (native, /api/discovery/*) ──────────────────────────────
# ONVIF scan/probe runs inside this API against the unified cameras table.

# Derives the Fernet key that encrypts stored camera credentials at rest.
# CHANGE THIS — rotating it invalidates stored creds.
DISCOVERY_SECRET_KEY=please-generate-a-long-random-string

# Default IP range pre-filled in the scan form (CIDR)
DISCOVERY_DEFAULT_CIDR=192.168.2.0/24
