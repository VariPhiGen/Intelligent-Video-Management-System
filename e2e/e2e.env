# e2e.env — the environment the E2E stack boots with.
#
# DELIBERATELY NOT the repository's .env. That file carries a real appliance's
# secrets and, more importantly, its camera credentials are encrypted under its
# DISCOVERY_SECRET_KEY — pointing a test stack at it and then wiping volumes is
# how a developer loses a working install. This file is self-contained and the
# stack it describes shares nothing with a dev stack: different project name,
# different volumes, different ports.
#
# THE SECRETS BELOW ARE FIXED AND PUBLIC ON PURPOSE. The stack is bound to
# loopback and torn down after the run; determinism is worth more here than
# secrecy. They are still non-weak in the sense config.py's
# `insecure_default_secrets()` means: no "change-me" marker, no "admin"
# password. That guard refuses to boot a production deployment carrying
# placeholders, and E2E runs with dev_auth=False — a real Keycloak — so the
# guard is live and these values have to pass it.
#
# PORTS ARE IN THE 19xxx BLOCK so an E2E stack can run beside a developer's own
# without either noticing. compose publishes each service on the same number it
# binds inside, and `oidc_allowed_issuers` derives from KEYCLOAK_PORT, so
# moving a port here moves it consistently everywhere.

COMPOSE_PROFILES=search,frames

# ── Ports (19xxx block; see above) ───────────────────────────────────────────
API_PORT=19091
KEYCLOAK_PORT=19085
# RTSP_PORT IS NOT REMAPPED, and this one is a trap worth writing down.
#
# It looks like a host-side publish port, and under the bridge overlay it is
# half of one: `"${RTSP_PORT}:8654"`. But the CONTAINER side is the literal
# 8654 — deploy/mediamtx.yml hardcodes it and the overlay only rebinds the
# interface (MTX_RTSPADDRESS: 0.0.0.0:8654). Meanwhile the api builds its
# internal relay URL as rtsp://${RELAY_INTERNAL_HOST}:${RTSP_PORT}, so moving
# this variable points the api at a port MediaMTX is not listening on, and
# every camera fails to relay with no obvious cause.
#
# Host-side isolation is achieved instead by not publishing MediaMTX's ports at
# all in the E2E overlay: nothing in the tests connects to RTSP from the host.
RTSP_PORT=8654
POSTGRES_PORT=19433
SEARCHDB_PORT=19434
REDIS_HOST_PORT=19380
# NVR_PORT / MOTION_PORT / SMARTSEARCH_PORT are deliberately NOT remapped.
#
# Under the bridge overlay those three are internal-only — nothing publishes
# them to the host — so there is no collision to avoid. Remapping them anyway
# breaks their health: docker-compose.yml's healthchecks hardcode the DEFAULT
# port numbers (8009 / 8012 / 8013) while each service's command binds
# ${NVR_PORT} and friends, so moving the variable moves the listener and leaves
# the check probing a port nothing is on. The services run fine and report
# unhealthy forever, which then blocks anything with a `depends_on: healthy`.
#
# That inconsistency lives in the product's compose file, not here; it is
# recorded rather than worked around, because the fix belongs in that file.

# ── Identity ─────────────────────────────────────────────────────────────────
# OIDC_ISSUER must name the port the BROWSER reaches Keycloak on: it is the
# `iss` the token carries, and security.py pins it against the allow-list.
OIDC_ISSUER=http://localhost:19085/realms/vms
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=e2e-keycloak-admin-4f2b9c1d7a83
# The seeded realm's own login, used by the browser tests.
VMS_ADMIN_USER=admin
VMS_ADMIN_PASSWORD=admin

# Real Keycloak, not the bypass. The whole point of J1 and J2.
DEV_AUTH=false

# ── Secrets the boot guard checks ────────────────────────────────────────────
INTERNAL_API_KEY=e2e-internal-6d41f0b28e5a4c93a7d15e8b0c62f4a9
DISCOVERY_SECRET_KEY=e2e-discovery-9c3e7f15a2b84d60
POSTGRES_PASSWORD=e2e_postgres_pw
SEARCHDB_PASSWORD=e2e_searchdb_pw

# ── Discovery ────────────────────────────────────────────────────────────────
# The ONVIF simulator answers on 8080. Keeping the list short makes a failed
# probe fast, which matters because J3 waits on it.
DISCOVERY_ONVIF_PORTS=[8080]
DISCOVERY_RTSP_PORT=8554
DISCOVERY_RTSP_TIMEOUT=8

# ── Determinism ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Short enough that J-session-expiry can observe a refresh without waiting.
# Keycloak's realm import sets accessTokenLifespan; this is the app-side poll.
NVR_DEFAULT_RETENTION_DAYS=7
