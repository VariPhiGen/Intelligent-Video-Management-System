// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

#define WIFI_SSID      "your-ssid"
#define WIFI_PASS      "your-wifi-password"

// The VMS host on the LAN — NOT 127.0.0.1, that is the board's own loopback.
#define MQTT_HOST      "192.168.31.211"
#define MQTT_PORT      1883
#define MQTT_USER      "vms"
#define MQTT_PASS      "the MQTT_PASSWORD from your .env"

// Must be unique on the broker. Two clients with the same id disconnect each
// other in a loop that looks like a flaky network.
#define MQTT_CLIENT_ID "site-siren"
